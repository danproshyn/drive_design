        "selector": "JSXOpeningElement[name.name='Notice'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:info|danger|success|warning|accent)$/]",
        "message": "<Notice> tone must be one of 'info' | 'danger' | 'success' | 'warning' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='OfferPartRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:href|image|brand|article|name|match|inStock|offers|restCount|restFrom|onExpandRest|className|key|ref|className|style|children)$/]",
        "message": "<OfferPartRow> doesn't accept that prop. Declared props: href, image, brand, article, name, match, inStock, offers, restCount, restFrom, onExpandRest, className."
